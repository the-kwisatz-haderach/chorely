{
  "name": "chorely",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @chorely/web db:migrate",
    "db:generate": "pnpm --filter @chorely/web db:generate",
    "dev": "pnpm --filter @chorely/web dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && pnpm lint:css && pnpm lint:md",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:md": "prettier --check \"**/*.md\"",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @chorely/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.9.10",
    "stylelint": "^16.26.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
