DATABASE_URL=postgres://chorely:chorely@localhost:5433/chorely
# Signs and hashes sign-in codes. Required in production; any long random string.
AUTH_SECRET=dev-only-change-me
# Optional. Without RESEND_API_KEY, emails (including sign-in codes) are logged to the server console.
# RESEND_API_KEY=
# EMAIL_FROM=Chorely <login@yourdomain.com>
# Proxies that append to X-Forwarded-For in front of the app (default 1). Used for per-IP rate limits.
# TRUSTED_PROXY_HOPS=1
